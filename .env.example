# CONFIGURAZIONE VARIABILI D'AMBIENTE (SEGRETI)
# Copia questo file in un file chiamato .env (oppure configuralo nei Secrets di Supabase)

# 1. Telegram Bot Token (da BotFather)
TELEGRAM_BOT_TOKEN="il_tuo_token_telegram_qui"

# 2. Google AI Studio API Key (da https://aistudio.google.com)
GEMINI_API_KEY="la_tua_chiave_gemini_qui"

# 3. Supabase Cloud Credentials (da Project Settings -> API)
SUPABASE_URL="https://tuo-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="la_tua_service_role_key_segreta"

# 4. Intervals.icu (Opzionale: per telemetria smartwatch Huawei/Garmin)
INTERVALS_ATHLETE_ID="il_tuo_id_atleta_es_i12345"
INTERVALS_API_KEY="la_tua_api_key_intervals"

# 5. Profilo Atleta di default (usato per inizializzare il coach)
ATHLETE_NAME="Nome Atleta"
ATHLETE_AGE="34"
ATHLETE_HEIGHT="189"
ATHLETE_TARGET="Hyrox Open Men SUB-1h 20m"
